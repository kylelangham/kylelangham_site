{
  "trailingSlash": false,
  "rewrites": [
    { "source": "/notre-dame-boards", "destination": "https://nd-trends.vercel.app/" },
    { "source": "/notre-dame-boards/:path*", "destination": "https://nd-trends.vercel.app/:path*" },
    { "source": "/shoota", "destination": "https://shoota-blue.vercel.app/" },
    { "source": "/shoota/:path*", "destination": "https://shoota-blue.vercel.app/:path*" },
    { "source": "/notre-dame-pickem", "destination": "https://notre-dame-pickem.vercel.app/notre-dame-pickem" },
    { "source": "/notre-dame-pickem/:path*", "destination": "https://notre-dame-pickem.vercel.app/notre-dame-pickem/:path*" },
    { "source": "/corey_tracker", "destination": "https://<host>.vercel.app/corey_tracker" },
    { "source": "/corey_tracker/:path*", "destination": "https://<host>.vercel.app/corey_tracker/:path*" }

  ]
}
